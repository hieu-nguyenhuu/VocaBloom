  "dialogue": {
    "lines": [
      { "speaker": "A", "text_zh": "你好，请问经理在办公室吗？", "pinyin": "Nǐ hǎo, qǐngwèn jīnglǐ zài bàngōngshì ma?", "text_vi": "Chào chị, cho hỏi giám đốc có ở văn phòng không ạ?", "highlight_vocab_temp_ids": ["v8", "v9"] },
      { "speaker": "B", "text_zh": "他在三楼，您上去吧。我是他的秘书。", "pinyin": "Tā zài sān lóu, nín shàngqù ba. Wǒ shì tā de mìshū.", "text_vi": "Ông ấy ở tầng ba, mời anh lên. Tôi là thư ký của ông ấy.", "highlight_vocab_temp_ids": ["v2", "v7"] },
      { "speaker": "A", "text_zh": "谢谢。您能告诉我怎么走吗？", "pinyin": "Xièxie. Nín néng gàosu wǒ zěnme zǒu ma?", "text_vi": "Cảm ơn chị. Chị chỉ giúp tôi đường đi được không?", "highlight_vocab_temp_ids": ["v10"] },
      { "speaker": "B", "text_zh": "很容易，出电梯就看见了。", "pinyin": "Hěn róngyì, chū diàntī jiù kànjiàn le.", "text_vi": "Dễ lắm, ra khỏi thang máy là thấy ngay.", "highlight_vocab_temp_ids": ["v6"] },
      { "speaker": "A", "text_zh": "好的。不好意思，我走得慢，昨天爬山以后腿很疼。", "pinyin": "Hǎo de. Bù hǎoyìsi, wǒ zǒu de màn, zuótiān páshān yǐhòu tuǐ hěn téng.", "text_vi": "Vâng. Ngại quá, tôi đi hơi chậm, hôm qua leo núi xong chân đau lắm.", "highlight_vocab_temp_ids": ["v4", "v5"] },
      { "speaker": "B", "text_zh": "我也常常这样，脚也不舒服。", "pinyin": "Wǒ yě chángcháng zhèyàng, jiǎo yě bù shūfu.", "text_vi": "Tôi cũng hay bị thế, bàn chân cũng khó chịu.", "highlight_vocab_temp_ids": ["v1"] },
      { "speaker": "A", "text_zh": "其实多运动身体会好一点儿。", "pinyin": "Qíshí duō yùndòng shēntǐ huì hǎo yìdiǎnr.", "text_vi": "Thực ra vận động nhiều thì người sẽ khoẻ hơn.", "highlight_vocab_temp_ids": ["v12"] },
      { "speaker": "B", "text_zh": "是啊，我最近胖了，我朋友却瘦了很多。", "pinyin": "Shì a, wǒ zuìjìn pàng le, wǒ péngyou què shòu le hěn duō.", "text_vi": "Đúng vậy, dạo này tôi mập ra, còn bạn tôi thì gầy đi nhiều.", "highlight_vocab_temp_ids": ["v11", "v13"] },
      { "speaker": "A", "text_zh": "楼下那几棵树旁边可以散步，很舒服。", "pinyin": "Lóu xià nà jǐ kē shù pángbiān kěyǐ sànbù, hěn shūfu.", "text_vi": "Bên mấy cái cây dưới nhà đi dạo được đấy, thoải mái lắm.", "highlight_vocab_temp_ids": ["v3"] },
      { "speaker": "B", "text_zh": "好主意，下班以后我去试试。", "pinyin": "Hǎo zhǔyi, xiàbān yǐhòu wǒ qù shìshi.", "text_vi": "Ý hay đấy, tan làm tôi sẽ thử.", "highlight_vocab_temp_ids": [] }
    ]
  }
}
