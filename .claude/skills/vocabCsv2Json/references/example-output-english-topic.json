  "dialogue": {
    "lines": [
      {
        "speaker": "A",
        "text_zh": "What do you want to be in the future?",
        "pinyin": "",
        "text_vi": "Sau này bạn muốn làm nghề gì?",
        "highlight_vocab_temp_ids": [],
        "text_secondary": "你以后想做什么工作？"
      },
      {
        "speaker": "B",
        "text_zh": "I want to become a teacher.",
        "pinyin": "",
        "text_vi": "Tôi muốn trở thành giáo viên.",
        "highlight_vocab_temp_ids": [
          "v1"
        ],
        "text_secondary": "我想当老师。"
      },
      {
        "speaker": "A",
        "text_zh": "That's a great choice! Teaching is very meaningful.",
        "pinyin": "",
        "text_vi": "Lựa chọn tuyệt vời đấy! Dạy học rất ý nghĩa.",
        "highlight_vocab_temp_ids": [],
        "text_secondary": "这个选择很好！教书很有意义。"
      },
      {
        "speaker": "B",
        "text_zh": "What about you?",
        "pinyin": "",
        "text_vi": "Còn bạn thì sao?",
        "highlight_vocab_temp_ids": [],
        "text_secondary": "你呢？"
      },
      {
        "speaker": "A",
        "text_zh": "I'm planning to become a doctor.",
        "pinyin": "",
        "text_vi": "Tôi đang dự định trở thành bác sĩ.",
        "highlight_vocab_temp_ids": [
          "v2"
        ],
        "text_secondary": "我打算当医生。"
      },
      {
        "speaker": "B",
        "text_zh": "Being a doctor is a noble job too.",
        "pinyin": "",
        "text_vi": "Làm bác sĩ cũng là một công việc cao quý.",
        "highlight_vocab_temp_ids": [
          "v2"
        ],
        "text_secondary": "当医生也是一份很高尚的工作。"
      },
      {
        "speaker": "A",
        "text_zh": "I hope we both achieve our dreams.",
        "pinyin": "",
        "text_vi": "Hy vọng cả hai chúng ta đều đạt được ước mơ.",
        "highlight_vocab_temp_ids": [],
        "text_secondary": "希望我们都能实现梦想。"
      }
    ]
  },
