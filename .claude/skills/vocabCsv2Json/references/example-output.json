  "exercises": [

    { "vocab_temp_id": "v1", "type": "grammar",
      "payload": {
        "content_target": "苹果是圆形水果，用量词\"个\"：一个苹果，两个苹果。不能用\"只\"或\"条\"。",
        "pinyin": "píngguǒ shì yuánxíng shuǐguǒ, yòng liàngcí \"ge\": yí ge píngguǒ, liǎng ge píngguǒ.",
        "content_vi": "苹果 (táo) là trái cây hình tròn, dùng lượng từ \"个\": một quả táo, hai quả táo. Không dùng \"只\" hay \"条\"."
      }
    },
    { "vocab_temp_id": "v2", "type": "grammar",
      "payload": {
        "content_target": "香蕉是长条形水果，用量词\"根\"：一根香蕉。因为形状细长，像\"根\"一样。",
        "pinyin": "xiāngjiāo shì chángtiáoxíng shuǐguǒ, yòng liàngcí \"gēn\": yì gēn xiāngjiāo.",
        "content_vi": "香蕉 (chuối) là trái cây dài, dùng lượng từ \"根\" (giống que/nhánh) vì hình dáng thon dài: một quả chuối."
      }
    },
    { "vocab_temp_id": "v3", "type": "grammar",
      "payload": {
        "content_target": "橙子和苹果一样，是圆形水果，也用量词\"个\"：一个橙子。",
        "pinyin": "chéngzi hé píngguǒ yíyàng, shì yuánxíng shuǐguǒ, yě yòng liàngcí \"ge\": yí ge chéngzi.",
        "content_vi": "橙子 (cam) giống táo, là trái cây hình tròn, cũng dùng lượng từ \"个\": một quả cam."
      }
    },
    { "vocab_temp_id": "v4", "type": "grammar",
      "payload": {
        "content_target": "葡萄一颗一颗长在一起，成串生长，所以用量词\"串\"：一串葡萄。单独一颗则用\"颗\"。",
        "pinyin": "pútáo yì kē yì kē zhǎng zài yìqǐ, chéngchuàn shēngzhǎng, suǒyǐ yòng liàngcí \"chuàn\": yí chuàn pútáo.",
        "content_vi": "葡萄 (nho) mọc thành từng chùm nên dùng lượng từ \"串\" (chùm): một chùm nho. Nếu tính từng quả riêng lẻ thì dùng \"颗\"."
      }
    },
    { "vocab_temp_id": "v5", "type": "grammar",
      "payload": {
        "content_target": "西瓜整个用\"个\"：一个西瓜。切开后一块一块用\"片\"：一片西瓜。",
        "pinyin": "xīguā zhěnggè yòng \"ge\": yí ge xīguā. qiē kāi hòu yí piàn xīguā.",
        "content_vi": "西瓜 (dưa hấu) nguyên quả dùng \"个\": một quả dưa hấu. Sau khi cắt thành từng miếng thì dùng \"片\": một miếng dưa hấu."
      }
    },

